+/* Take meeting notes: a labelled pill on its own line under mute and end,
+   because what it does is not a glyph anyone already knows, and an icon
+   needing a tooltip has none on a phone. Only where notetaker.js is loaded;
+   without it the break is gone too and the pair sits exactly as before. */
+.vx-dock { flex-wrap: wrap; row-gap: 0.875rem; }
+.vx-dock-br { flex-basis: 100%; height: 0; }
+.vx-dock:has(.vx-notes[hidden]) .vx-dock-br { display: none; }
+.vx-notes {
+  display: inline-flex; align-items: center; gap: 0.5rem;
+  height: 2.5rem; padding: 0 1.125rem; border: 0; border-radius: 999px;
+  background: var(--card-bg-raised); color: var(--ink-primary);
+  box-shadow: inset 0 0 0 0.0625rem var(--card-border);
+  font: inherit; font-size: var(--ty-meta); font-weight: var(--fw-semibold); cursor: pointer;
+  transition: box-shadow var(--t-fast) var(--ease-out), transform var(--t-press) var(--ease-out);
+}
+.vx-notes[hidden] { display: none; }
+.vx-notes svg { width: 1.125rem; height: 1.125rem; color: var(--brand); }
+.vx-notes:hover { box-shadow: inset 0 0 0 0.0625rem rgba(var(--brand-rgb), 0.5); }
+.vx-notes:active { transform: scale(0.97); }
+.vx-notes:focus-visible { outline: 0.125rem solid var(--brand); outline-offset: 0.1875rem; }
+
