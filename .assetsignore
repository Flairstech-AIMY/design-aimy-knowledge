# What `wrangler deploy` must not publish. The assets directory is the repo
# root, so without this the git history, local tool settings, notes and dev
# scripts would be served to anyone who asks for them.
.git
.gitattributes
.gitignore
.assetsignore
.claude
.impeccable
.wrangler
.dev.vars*
.env*
node_modules
wrangler.jsonc
devserver.py
_flat.js
README.md
GAPS.md
assets/halaska-build.sh
